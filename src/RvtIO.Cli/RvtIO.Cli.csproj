<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>RvtIO.Cli</PackageId>
    <Description>Command line tool that reads Autodesk Revit files (.rvt, .rfa) without Revit and writes IFC or JSON.</Description>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rvtio</ToolCommandName>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- The read and export are allocation-heavy: server GC with a large gen0 budget cut a full run by ~20%. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RvtIO\RvtIO.csproj" />
  </ItemGroup>

</Project>
