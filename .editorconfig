root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.{tsv,gz}]
trim_trailing_whitespace = false
insert_final_newline = unset

[*.md]
trim_trailing_whitespace = false
