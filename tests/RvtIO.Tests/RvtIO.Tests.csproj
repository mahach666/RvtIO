<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>RvtIO.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="OpenMcdf" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Frozen hashes of the original Revit resources. -->
    <EmbeddedResource Include="Fixtures\Frozen\*.tsv" LogicalName="Frozen.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RvtIO\RvtIO.csproj" />
    <!-- Compile the research decoder itself: no copied test implementation or CLI dependency. -->
    <Compile Include="..\..\tools\RootProbe\HistoryBoundaryProbe.cs" Link="RootProbe\HistoryBoundaryProbe.cs" />
    <Compile Include="..\..\tools\RootProbe\StairBoundaryProbe.cs" Link="RootProbe\StairBoundaryProbe.cs" />
    <Compile Include="..\..\tools\RootProbe\UnitOptionsProbe.cs" Link="RootProbe\UnitOptionsProbe.cs" />
    <Compile Include="..\..\tools\RootProbe\ExactStreamProbe.cs" Link="RootProbe\ExactStreamProbe.cs" />
    <Compile Include="..\..\tools\RootProbe\DeferredFieldProbe.cs" Link="RootProbe\DeferredFieldProbe.cs" />
    <Compile Include="..\..\tools\RootProbe\ParameterInputProbe.cs" Link="RootProbe\ParameterInputProbe.cs" />
    <!-- The command line option parser of the CLI, compiled here to test it without starting the tool. -->
    <Compile Include="..\..\src\RvtIO.Cli\JsonClassPrefixOption.cs" Link="Cli\JsonClassPrefixOption.cs" />
  </ItemGroup>

</Project>
